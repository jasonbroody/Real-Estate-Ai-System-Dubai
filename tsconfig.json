{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "esnext"
                                    ],
                            "allowJs":  true,
                            "skipLibCheck":  true,
                            "strict":  true,
                            "noEmit":  true,
                            "esModuleInterop":  true,
                            "module":  "esnext",
                            "moduleResolution":  "bundler",
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "jsx":  "react-jsx",
                            "incremental":  true,
                            "plugins":  [
                                            {
                                                "name":  "next"
                                            }
                                        ]
                        },
    "include":  [
                    "next-env.d.ts",
                    "src/app/**/*.tsx",
                    "src/App.tsx",
                    "src/components/PresentationUI.tsx",
                    "src/components/SystemDiagram.tsx",
                    "src/components/WorkflowDemo.tsx",
                    "src/components/DeveloperPreview.tsx",
                    "src/components/PilotDialog.tsx",
                    "src/data/presentation.ts",
                    "next.config.ts",
                    ".next/types/**/*.ts",
                    ".next/dev/types/**/*.ts"
                ],
    "exclude":  [
                    "node_modules"
                ]
}
